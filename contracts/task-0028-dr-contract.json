{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upfs.local/contracts/task-0028-dr.v1.json",
  "title": "UPFS cells, regions, and disaster recovery contract",
  "type": "object",
  "required": ["schema_version", "version", "regions", "cells", "tenant_routing", "evacuation", "backups", "restore_points", "failover", "objectives"],
  "properties": {
    "schema_version": { "const": "upfs.dr.v1" },
    "version": { "type": "string", "minLength": 1 },
    "regions": { "type": "array", "minItems": 2 },
    "cells": { "type": "array", "minItems": 2 },
    "tenant_routing": { "type": "array", "minItems": 1 },
    "evacuation": { "type": "object", "required": ["owner", "approval", "procedure", "max_minutes"] },
    "backups": { "type": "array", "minItems": 1 },
    "restore_points": { "type": "array", "minItems": 1 },
    "failover": { "type": "object", "required": ["owner", "target_region", "approval", "corrective_forward"] },
    "objectives": { "type": "object", "required": ["rpo_minutes", "rto_minutes"], "properties": { "rpo_minutes": { "type": "number", "exclusiveMinimum": 0 }, "rto_minutes": { "type": "number", "exclusiveMinimum": 0 } } }
  }
}
