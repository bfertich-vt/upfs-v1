{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/upfs/transaction/1.1.0",
  "title": "CanonicalTransaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenant_id",
    "environment_id",
    "account_id",
    "amount",
    "currency",
    "posted_at",
    "schema_version",
    "lifecycle_state",
    "valid_time",
    "source_observations",
    "evidence_refs",
    "confidence",
    "provenance",
    "data_classification",
    "provider_categories",
    "taxonomy"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/uuid" },
    "tenant_id": { "$ref": "#/$defs/uuid" },
    "environment_id": { "$ref": "#/$defs/uuid" },
    "account_id": { "$ref": "#/$defs/uuid" },
    "amount": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,4})?$"
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "posted_at": { "$ref": "#/$defs/dateTime" },
    "description": { "type": "string", "maxLength": 2048 },
    "schema_version": { "const": "1.1.0" },
    "lifecycle_state": { "enum": ["active", "corrected", "voided"] },
    "valid_time": { "$ref": "#/$defs/interval" },
    "system_time": { "$ref": "#/$defs/interval" },
    "source_observations": { "$ref": "#/$defs/references" },
    "evidence_refs": { "$ref": "#/$defs/references" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provenance" }
    },
    "data_classification": {
      "enum": ["restricted", "confidential", "internal"]
    },
    "created_by": { "type": "string", "minLength": 1, "maxLength": 300 },
    "updated_by": { "type": "string", "minLength": 1, "maxLength": 300 },
    "version": { "type": "integer", "minimum": 1 },
    "provider_categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "category"],
        "properties": {
          "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
          "category": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "family",
        "class",
        "subclass",
        "intent",
        "cash_flow_role",
        "tax_relevance",
        "recurrence"
      ],
      "properties": {
        "domain": { "$ref": "#/$defs/taxonomyValue" },
        "family": { "$ref": "#/$defs/taxonomyValue" },
        "class": { "$ref": "#/$defs/taxonomyValue" },
        "subclass": { "$ref": "#/$defs/taxonomyValue" },
        "intent": { "$ref": "#/$defs/taxonomyValue" },
        "cash_flow_role": { "$ref": "#/$defs/taxonomyValue" },
        "tax_relevance": { "$ref": "#/$defs/taxonomyValue" },
        "recurrence": { "$ref": "#/$defs/taxonomyValue" }
      }
    },
    "merchant_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/dateTime" },
        "to": { "oneOf": [{ "$ref": "#/$defs/dateTime" }, { "type": "null" }] }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor", "at", "source_ref"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 100 },
        "actor": { "type": "string", "minLength": 1, "maxLength": 300 },
        "at": { "$ref": "#/$defs/dateTime" },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "taxonomyValue": { "type": "string", "minLength": 1, "maxLength": 100 }
  }
}
