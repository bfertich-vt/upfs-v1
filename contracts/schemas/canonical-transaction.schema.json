{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/upfs/transaction/1.0.0",
  "title": "CanonicalTransaction",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tenant_id", "account_id", "amount", "currency", "posted_at", "schema_version", "evidence_refs"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "account_id": {"type": "string", "minLength": 1},
    "amount": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{1,4})?$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "posted_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "description": {"type": "string", "maxLength": 2048},
    "schema_version": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "version": {"type": "integer", "minimum": 1},
    "provenance": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "actor", "at"], "properties": {"kind": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "at": {"type": "string", "format": "date-time"}}}}
  }
}
