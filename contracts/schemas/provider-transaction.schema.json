{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/upfs/provider-transaction/1.0.0",
  "title": "ProviderTransactionObservation",
  "type": "object", "additionalProperties": false,
  "required": ["provider_transaction_id", "account_id", "amount", "currency", "posted_at"],
  "properties": {
    "provider_transaction_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "account_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "amount": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{1,4})?$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "posted_at": {"type": "string", "format": "date-time"},
    "description": {"type": "string", "maxLength": 2048},
    "category": {"type": "string", "maxLength": 300}
  }
}
