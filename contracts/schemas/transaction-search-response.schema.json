{
  "$id": "https://upfs.example.invalid/schemas/transaction-search-response/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transaction search response",
  "type": "object",
  "required": ["request_id", "data", "page", "consistency", "watermark"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "data": {"type": "array", "items": {"$ref": "./transaction.schema.json"}},
    "page": {"type": "object", "required": ["limit", "next_cursor"], "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 100}, "next_cursor": {"type": ["string", "null"]}}, "additionalProperties": false},
    "consistency": {"const": "eventually_consistent_projection"},
    "watermark": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
