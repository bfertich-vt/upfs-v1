{
  "$id": "https://upfs.example.invalid/schemas/transaction-search-response/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transaction search response",
  "type": "object",
  "required": ["request_id", "data", "page", "consistency", "watermark"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "data": {"type": "array", "items": {"$ref": "#/$defs/projectionTransaction"}},
    "page": {"type": "object", "required": ["limit", "next_cursor"], "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 100}, "next_cursor": {"type": ["string", "null"]}}, "additionalProperties": false},
    "consistency": {"const": "eventually_consistent_projection"},
    "watermark": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false,
  "$defs": {
    "projectionTransaction": {
      "type": "object",
      "required": ["id", "tenant_id", "account_id", "amount", "currency", "posted_at", "schema_version", "evidence_refs", "source_version", "projection_version"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "tenant_id": {"type": "string", "minLength": 1}, "account_id": {"type": "string", "minLength": 1},
        "amount": {"type": "string"}, "currency": {"type": "string", "minLength": 3, "maxLength": 3}, "posted_at": {"type": "string", "format": "date-time"},
        "schema_version": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "description": {"type": "string", "maxLength": 2048}, "source_version": {"type": "integer", "minimum": 1}, "projection_version": {"const": "1.0.0"}
      },
      "additionalProperties": false
    }
  }
}
