{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upfs.example.invalid/schemas/identity-foundation.schema.json",
  "title": "Identity and tenant foundation resources",
  "type": "object",
  "required": ["id", "kind", "version", "created_at", "status"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "kind": {"enum": ["identity", "organization", "tenant", "environment", "membership"]},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["active", "suspended", "deactivated"]},
    "organization_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "environment_id": {"type": "string", "format": "uuid"},
    "issuer": {"type": "string", "format": "uri"},
    "subject": {"type": "string", "minLength": 1},
    "roles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false
}
